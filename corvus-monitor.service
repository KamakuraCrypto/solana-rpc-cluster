[Unit]
Description=Corvus Proxy Network Monitor (Discord Alerts)
After=corvus-proxy.service
Wants=corvus-proxy.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/corvus-monitor.env
ExecStart=/usr/local/bin/corvus-monitor
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
