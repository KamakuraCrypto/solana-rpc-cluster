#!/usr/bin/env bash
# Monitors Frankfurt Yellowstone gRPC upstream health.
# Watches corvus-proxy journal for fra mux events + runs periodic direct probes.
# Logs to /var/log/fra-monitor.log and journal.

LOG=/var/log/fra-monitor.log
FRA_HOST="fra.corvus-labs.io:10101"
PROBE_INTERVAL=60

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" | tee -a "$LOG"; }

active_probe() {
    local http_code ttfb
    # gRPC GetVersion — 5-byte length-prefix for empty protobuf message
    read -r http_code ttfb < <(
        curl -s -o /dev/null \
            --http2-prior-knowledge \
            --max-time 10 \
            -w "%{http_code} %{time_starttransfer}" \
            -X POST \
            -H "Content-Type: application/grpc" \
            -H "TE: trailers" \
            --data-binary $'\x00\x00\x00\x00\x00' \
            "http://${FRA_HOST}/geyser.Geyser/GetVersion" 2>/dev/null
    )

    if [[ -z "$http_code" ]]; then
        log "PROBE fra GetVersion TIMEOUT (>10s) — upstream still wedged"
        return 1
    elif [[ "$http_code" == "200" ]]; then
        log "PROBE fra GetVersion OK (http=$http_code ttfb=${ttfb}s)"
        return 0
    else
        log "PROBE fra GetVersion FAILED (http=$http_code ttfb=${ttfb}s)"
        return 1
    fi
}

touch "$LOG"
log "fra-monitor started. Probing $FRA_HOST every ${PROBE_INTERVAL}s."

# Background: tail proxy journal for fra-related events
journalctl -u corvus-proxy.service -f --output=cat 2>/dev/null \
    | grep --line-buffered -iE '\bfra\b|frankfurt|mux\[fra\]' \
    | while IFS= read -r line; do
        log "PROXY: $line"
    done &

# Foreground: periodic active probe loop
fra_was_ok=false
while true; do
    if active_probe; then
        if [[ "$fra_was_ok" == "false" ]]; then
            log "*** FRA RECOVERY DETECTED — fra upstream is now healthy ***"
        fi
        fra_was_ok=true
    else
        fra_was_ok=false
    fi
    sleep "$PROBE_INTERVAL"
done
